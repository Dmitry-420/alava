---
import { Icon } from 'astro-icon/components';
import { highlights } from '../data/product';
---

<section id="premium" class="mx-auto max-w-6xl px-5 py-20">
  <p class="eyebrow">Почему Alava</p>
  <h2 class="section-title mt-4 max-w-2xl">Идеальный баланс мощности и комфорта</h2>
  <p class="mt-5 max-w-2xl text-mist-200">
    Продуманная конструкция для прогулок, туринга и рыбалки: от жёсткости двухслойного ПВХ до деталей,
    которые чувствуешь на воде.
  </p>

  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      highlights.map((item) => (
        <article class="card p-7 transition duration-300 hover:-translate-y-1 hover:border-water-400/40">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-water-500/15 text-water-300">
            <Icon name={item.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-5 text-lg text-white">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-mist-200">{item.text}</p>
        </article>
      ))
    }
  </div>
</section>
